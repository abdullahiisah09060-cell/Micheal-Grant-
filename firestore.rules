rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- BASIC HELPERS ---
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuth() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- COLLECTION RULES ---

    // Users: Owner can read/write their own; Admin has full access
    match /users/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      allow create: if isAuth() && isOwner(uid);
      allow update: if isAuth() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
      
      // Ledger Subcollection
      match /ledger/{entryId} {
        allow read: if isAuth() && (isOwner(uid) || isAdmin());
        allow write: if isAdmin(); // Only admins or system logic (via admin) write to ledger
      }
    }

    // Notifications: Users read their own; Admins read all and write to all
    match /notifications/{notifId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth(); // Users can create notifications for admins
      allow update: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Chat: Access restricted to the specific user and the support agents
    match /chat/{uid}/messages/{msgId} {
      allow read, write: if isAuth() && (isOwner(uid) || isAdmin());
    }

    // Config: Public read for maintenance/stats; Admin write only
    match /config/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Audit Log: Sensitive logs accessible only to administrators
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit logs should be immutable
    }
  }
}
