rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isAdmin() { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
      
      match /ledger/{entry} {
        allow read: if isAuth() && (isOwner(uid) || isAdmin());
        allow create, update, delete: if isAdmin();
      }
    }

    match /notifications/{notif} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth();
      allow update, delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    match /chat/{uid}/messages/{msg} {
      allow read, write: if isAuth() && (isOwner(uid) || isAdmin());
    }

    match /auditLog/{log} {
      allow read, create: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
