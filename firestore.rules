rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if user is an admin
    function isAdmin() {
      return isAuth() && (
        request.auth.token.email == 'sba.suppor@gmail.com' || 
        request.auth.token.email == 'liger4683@gmail.com'
      );
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      
      // Nested Ledger Rules
      match /ledger/{entryId} {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin(); // Only admins can modify financials
      }
    }

    // Notification Rules
    match /notifications/{notifId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth(); // Allow users to trigger notifications
      allow update: if isAuth() && request.auth.uid == resource.data.uid;
    }

    // Support Chat Rules
    match /chat/{msgId} {
      allow read, write: if isAuth(); // In a full build, we'd limit this to specific thread IDs
    }

    // Audit Log Rules
    match /auditLog/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
